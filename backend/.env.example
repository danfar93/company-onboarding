# Get your API key from https://developer.company-information.service.gov.uk
# NOTE: register a *Live* application for real company data. A *Test*
# application's key only authenticates against the sandbox host below.
COMPANIES_HOUSE_API_KEY=your_api_key_here

# Optional. Defaults to the live host. Point at the sandbox when using a test
# key: https://api-sandbox.company-information.service.gov.uk
# COMPANIES_HOUSE_API_BASE=https://api-sandbox.company-information.service.gov.uk

CLAUDE_API_KEY=your_key_here
